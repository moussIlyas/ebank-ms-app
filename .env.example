# Required environment variables (documented here - NOT loaded automatically).
# Spring Boot reads OS environment variables natively.
#
# Local dev:      export OLLAMA_API_KEY=... && export TAVILY_API_KEY=...
# GitHub Actions: add as repository Settings > Secrets > Actions, then expose
#                 with `env:` in the workflow step that runs the build.
# Deployment:     Docker `-e VAR=...` or Kubernetes Secret -> env var.
OLLAMA_API_KEY=
TAVILY_API_KEY=
